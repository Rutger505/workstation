#!/usr/bin/env bash
# Headless test VM for workstation: KVM + OVMF (UEFI), no GPU, Hyprland renders in software (llvmpipe).
# Screen via QMP screendump, input via QMP send-key, shell via SSH, serial console in $VM_DIR/<distro>.serial.log.
#
#   test/vm <distro> install          fresh archinstall from the latest ISO, then snapshot "base"
#   test/vm <distro> up               boot (arch-luks: types the passphrase), wait for SSH
#   test/vm <distro> ssh [CMD...]     shell / command in the guest (user arch, key auth)
#   test/vm <distro> shot [FILE]      screenshot as PNG (default $VM_DIR/<distro>.png)
#   test/vm <distro> key COMBO...     press keys, QEMU names: meta_l-ret, ctrl-alt-f2, a, spc
#   test/vm <distro> type TEXT        type text (a-z, 0-9, space, a few symbols)
#   test/vm <distro> down             power off (hard after 30s)
#   test/vm <distro> save|restore N   disk snapshot N (VM must be down)
#   test/vm <distro> reset            back to snapshot "base"
#   test/vm <distro> status
#
# Distros: arch (btrfs, Limine), arch-luks (same, root in LUKS, passphrase arch). fedora: TODO.
# Env: VM_DIR (~/.cache/workstation-vm), VM_MEM (2048), VM_CPUS (2), VM_SSH_PORT (2222 arch, 2223 arch-luks).
set -euo pipefail

VM_DIR=${VM_DIR:-$HOME/.cache/workstation-vm}
VM_MEM=${VM_MEM:-2048}
VM_CPUS=${VM_CPUS:-2}
iso_url=https://geo.mirror.pkgbuild.com/iso/latest
ovmf=/usr/share/edk2/x64
here=$(dirname "$(realpath "$0")")

die() { echo "vm: $*" >&2; exit 1; }

[[ $# -ge 2 ]] || { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
distro=$1 cmd=$2
shift 2

guest_user=arch guest_pass=arch luks=
case $distro in
  arch) port=${VM_SSH_PORT:-2222} ;;
  arch-luks) port=${VM_SSH_PORT:-2223} luks=arch ;;
  *) die "unknown distro '$distro' (arch, arch-luks)" ;;
esac

disk=$VM_DIR/$distro.qcow2
vars=$VM_DIR/$distro.vars.fd
serial=$VM_DIR/$distro.serial.log
qmp_sock=$VM_DIR/$distro.qmp
pidfile=$VM_DIR/$distro.pid
iso=$VM_DIR/archlinux-x86_64.iso
mkdir -p "$VM_DIR"

running() { [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

qmp() { # qmp '{"execute": ...}' -> raw replies
  running || die "$distro is not running"
  printf '{"execute":"qmp_capabilities"}\n%s\n' "$1" | socat -t 2 - "UNIX-CONNECT:$qmp_sock"
}

ssh_opts=(-p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5)

# shellcheck disable=SC2029 # args are meant to run in the guest
ssh_guest() { ssh "${ssh_opts[@]}" "$guest_user@127.0.0.1" "$@"; }

# shellcheck disable=SC2029
ssh_live() { ssh "${ssh_opts[@]}" -o BatchMode=yes root@127.0.0.1 "$@"; }

ssh_pass() { sshpass -p "$guest_pass" ssh "${ssh_opts[@]}" -o PubkeyAuthentication=no "$guest_user@127.0.0.1" "$@"; }

wait_for() { # seconds cmd... -> retry cmd every 2s
  local end=$((SECONDS + $1))
  shift
  until "$@" 2>/dev/null; do
    ((SECONDS < end)) || return 1
    running || die "$distro died, see $serial"
    sleep 2
  done
}

authorize_key() {
  local key
  key=$(cat "$HOME/.ssh/id_ed25519.pub")
  ssh_pass "mkdir -p ~/.ssh && chmod 700 ~/.ssh && grep -qxF '$key' ~/.ssh/authorized_keys 2>/dev/null || echo '$key' >> ~/.ssh/authorized_keys"
}

send_key() { # one combo, e.g. meta_l-ret
  local keys=() k
  IFS=- read -ra parts <<<"$1"
  for k in "${parts[@]}"; do keys+=("{\"type\":\"qcode\",\"data\":\"$k\"}"); done
  qmp "{\"execute\":\"send-key\",\"arguments\":{\"keys\":[$(IFS=,; echo "${keys[*]}")]}}" >/dev/null
  sleep 0.05
}

char_key() {
  case $1 in
    [a-z0-9]) echo "$1" ;;
    [A-Z]) echo "shift-${1,,}" ;;
    ' ') echo spc ;; '-') echo minus ;; '.') echo dot ;; '/') echo slash ;;
    '_') echo shift-minus ;; ':') echo shift-semicolon ;; '=') echo equal ;;
    *) die "can't type '$1'" ;;
  esac
}

type_text() {
  local i
  for ((i = 0; i < ${#1}; i++)); do send_key "$(char_key "${1:i:1}")"; done
}

start_vm() { # extra qemu args...
  : >"$serial"
  qemu-system-x86_64 \
    -name "workstation-$distro" -machine q35,accel=kvm -cpu host -smp "$VM_CPUS" -m "$VM_MEM" \
    -drive "if=pflash,format=raw,readonly=on,file=$ovmf/OVMF_CODE.4m.fd" \
    -drive "if=pflash,format=raw,file=$vars" \
    -drive "file=$disk,format=qcow2,if=virtio,discard=unmap" \
    -device virtio-vga -display none \
    -device virtio-keyboard-pci -device virtio-tablet-pci \
    -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:$port-:22" -device virtio-net-pci,netdev=net0 \
    -serial "file:$serial" \
    -qmp "unix:$qmp_sock,server,nowait" \
    -daemonize -pidfile "$pidfile" "$@"
}

wait_down() {
  local i
  for ((i = 0; i < ${1:-30}; i++)); do running || break; sleep 1; done
  running && { qmp '{"execute":"quit"}' >/dev/null || true; sleep 1; }
  rm -f "$pidfile" "$qmp_sock"
}

fetch_iso() {
  local sum
  sum=$(curl -fsSL "$iso_url/sha256sums.txt" | awk '$2 == "archlinux-x86_64.iso" {print $1}')
  [[ -n $sum ]] || die "no checksum for archlinux-x86_64.iso"
  [[ -f $iso ]] && sha256sum -c --status <<<"$sum  $iso" && return
  echo "downloading $iso_url/archlinux-x86_64.iso"
  curl -fL --progress-bar "$iso_url/archlinux-x86_64.iso" -o "$iso.part"
  sha256sum -c --status <<<"$sum  $iso.part" || die "ISO checksum mismatch"
  mv "$iso.part" "$iso"
}

# The encrypt hook prompts on tty0 only and cryptsetup flushes input typed too early.
# The kernel log on serial (loglevel=7, VM only) shows dm-crypt loading right before the prompt
# and btrfs mounting dm-0 after it; retype until that shows up.
unlock() {
  local i
  for ((i = 0; i < 5; i++)); do
    wait_for 120 grep -q 'device-mapper: ioctl' "$serial" || die "no LUKS prompt after 2 minutes, see $serial"
    sleep 2
    type_text "$luks"
    send_key ret
    wait_for 20 grep -q "BTRFS info (device dm-0)" "$serial" && return
  done
  die "LUKS unlock failed, see $serial and test/vm $distro shot"
}

install() {
  local layers
  running && die "install needs the VM down"
  fetch_iso
  rm -f "$disk" "$vars"
  qemu-img create -q -f qcow2 "$disk" 20G
  cp "$ovmf/OVMF_VARS.4m.fd" "$vars"
  seed=$(mktemp -d)
  trap 'rm -rf "$seed"' EXIT
  echo "instance-id: workstation-$distro" >"$seed/meta-data"
  printf '#cloud-config\nusers:\n  - name: root\n    ssh_authorized_keys:\n      - %s\n' "$(cat "$HOME/.ssh/id_ed25519.pub")" >"$seed/user-data"
  start_vm -cdrom "$iso" \
    -drive "if=none,id=seed,format=raw,snapshot=on,file.driver=vvfat,file.dir=$seed,file.label=CIDATA" \
    -device ide-hd,drive=seed
  echo "booting the ISO, waiting for SSH on port $port"
  wait_for 300 ssh_live true || die "no SSH into the live ISO after 5 minutes"
  layers=("$here/archinstall/user_configuration.json")
  [[ -n $luks ]] && layers+=("$here/archinstall/luks.json")
  jq -s 'reduce .[1:][] as $l (.[0]; . * $l + {custom_commands: (.custom_commands + $l.custom_commands)})' "${layers[@]}" \
    | ssh_live 'cat > /root/user_configuration.json'
  ssh_live 'cat > /root/user_credentials.json' <"$here/archinstall/user_credentials.json"
  echo "running archinstall $(ssh_live 'pacman -Q archinstall 2>/dev/null | cut -d" " -f2'), output in $VM_DIR/$distro.install.log"
  ssh_live 'archinstall --config /root/user_configuration.json --creds /root/user_credentials.json --silent' >"$VM_DIR/$distro.install.log" 2>&1 \
    || die "archinstall failed, see $VM_DIR/$distro.install.log (live ISO still running)"
  ssh_live 'poweroff' || true
  wait_down 60
  qemu-img snapshot -c base "$disk"
  echo "installed, snapshot base: test/vm $distro up"
}

case $cmd in
  install) install ;;
  up)
    running && { echo "$distro already running (ssh port $port)"; exit 0; }
    [[ -f $disk ]] || die "no disk, run: test/vm $distro install"
    start_vm
    echo "booting $distro"
    [[ -n $luks ]] && { echo "waiting for the LUKS prompt"; unlock; }
    echo "waiting for SSH on port $port"
    wait_for 180 ssh_pass true || die "no SSH after 3 minutes"
    authorize_key
    echo "up: test/vm $distro ssh"
    ;;
  ssh) ssh_guest "$@" ;;
  shot)
    out=$(realpath -m "${1:-$VM_DIR/$distro.png}")
    rm -f "$out"
    qmp "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\"$out\",\"format\":\"png\"}}" >/dev/null
    for ((i = 0; i < 20; i++)); do [[ -s $out ]] && break; sleep 0.25; done
    [[ -s $out ]] || die "screendump failed"
    echo "$out"
    ;;
  key) for combo in "$@"; do send_key "$combo"; done ;;
  type) type_text "$*" ;;
  down)
    running || { echo "$distro not running"; exit 0; }
    qmp '{"execute":"system_powerdown"}' >/dev/null
    wait_down 30
    echo "$distro down"
    ;;
  save | restore)
    [[ $# -eq 1 ]] || die "$cmd needs a snapshot name"
    running && die "$cmd needs the VM down"
    if [[ $cmd == save ]]; then qemu-img snapshot -c "$1" "$disk"; else qemu-img snapshot -a "$1" "$disk"; fi
    echo "$cmd $1 done"
    ;;
  reset)
    running && die "reset needs the VM down"
    qemu-img snapshot -a base "$disk"
    echo "$distro back at snapshot base"
    ;;
  status)
    if running; then echo "$distro running (pid $(cat "$pidfile"), ssh port $port)"; else echo "$distro down"; fi
    [[ -f $disk ]] && qemu-img snapshot -l "$disk" | tail -n +3 | awk '{print "snapshot: " $2}' || true
    ;;
  *) die "unknown command '$cmd'" ;;
esac
